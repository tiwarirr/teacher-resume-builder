#let accent = rgb("#2563eb")

#set page(margin: (x: 1.8cm, y: 1.5cm))
#set text(font: ("Noto Sans", "Noto Sans Devanagari"), size: 10pt)
#set par(justify: true)
#set list(marker: [#text(fill: accent)[#sym.bullet]])
#show heading.where(level: 1): set text(fill: accent, size: 13pt)

#align(center)[
  #text(size: 20pt, weight: "bold")[<< profile.full_name >>]

  #text(fill: accent)[<< profile.email >> #sym.dot.c << profile.phone >><< " " ~ "·" ~ " " ~ profile.address if profile.address else "" >>]
]

#v(4pt)
#line(length: 100%, stroke: 1.2pt + accent)

<% if summary %>
#text(style: "italic")[<< summary >>]
<% endif %>

<% if education %>
= << labels.education >>
<% for edu in education %>
- *<< edu.degree >>*, << edu.institution >> (<< edu.board_or_university >>) --- << edu.year >><< ", " ~ edu.score if edu.score else "" >>
<% endfor %>
<% endif %>

<% if qualifications %>
= << labels.qualifications >>
<% for q in qualifications %>
- *<< q.type >>* --- << q.issuing_body >>, << q.year >><< " (" ~ q.score_or_paper ~ ")" if q.score_or_paper else "" >>
<% endfor %>
<% endif %>

<% if experience %>
= << labels.experience >>
<% for exp in experience %>
== << exp.school >> --- << exp.post >> (<< exp.board >>)
#emph[<< exp.subjects | join(", ") >> #sym.dot.c << labels.classes_label >> << exp.classes_taught | join(", ") >> #sym.dot.c << exp.dates >>]
<% for bullet in exp.bullets %>
- << bullet >>
<% endfor %>
<% endfor %>
<% endif %>

<% if admin_roles %>
= << labels.admin_roles >>
<% for role in admin_roles %>
- *<< role.title >>* (<< role.duration >>) --- << role.description >>
<% endfor %>
<% endif %>

<% if edtech_skills %>
= << labels.edtech_skills >>
<< edtech_skills | join(", ") >>
<% endif %>

<% if trainings %>
= << labels.trainings >>
<% for t in trainings %>
- *<< t.title >>* --- << t.organizer >><< ", " ~ t.date if t.date else "" >>
<% endfor %>
<% endif %>
