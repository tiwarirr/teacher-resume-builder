# Copy this file to .env and fill in real values. Never commit .env.

# "development" (default) or "production". Production changes the session
# cookie to SameSite=None+Secure, required once the frontend and backend are
# on different sites (e.g. vercel.app / onrender.com) - see DEPLOYMENT.md.
ENVIRONMENT=development

# Postgres connection string (Neon/Supabase free tier, or local Postgres)
DATABASE_URL=postgresql://user:password@host:5432/teacher_resume

# Used to sign JWT session cookies - generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me

# OpenRouter API key (used for AI bullet rewriting, tailoring, cover letters): https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Optional: override the default models (Claude Haiku/Sonnet, see app/config.py).
# If you're out of OpenRouter credits, you can point these at a free model
# (search "free" at https://openrouter.ai/models) to keep developing without
# spending money - just know free models follow the "don't fabricate, ask for
# missing numbers" guardrail less reliably than Claude, so switch back before
# judging real output quality.
# OPENROUTER_MODEL_BULLET_REWRITE=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_MODEL_TAILORING=nvidia/nemotron-3-super-120b-a12b:free

# Stripe test-mode keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:3000
